{
  "id": "/",
  "name": "Mazer",
  "short_name": "Mazer",
  "description": "A fast neon maze game. Find your way to the goal, level after level, on your phone or computer.",
  "lang": "en-US",
  "start_url": "/",
  "scope": "/",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#02080f",
  "theme_color": "#02080f",
  "prefer_related_applications": false,
  "categories": [
    "games",
    "entertainment"
  ],
