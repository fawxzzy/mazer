  "decisions": [
    {
      "id": "product-direction-precision-arcade",
      "category": "product-direction",
      "locked": true,
      "statement": "Mazer's target product is the Fawxzzy Precision Arcade direction: a mobile-first, installable, precision-arcade maze game where the board is the hero and application chrome only explains, enables, or protects play.",
      "sourceRef": "blueprint/00_EXECUTIVE_DECISIONS.md#chosen-direction--fawxzzy-precision-arcade"
    },
    {
      "id": "renderer-ownership-split",
      "category": "architecture",
      "locked": true,
      "statement": "Phaser owns world/maze simulation-facing presentation (board rendering, title path animation, world-space entities, camera/world effects, menu demonstration maze, world diagnostics). DOM owns application shell, forms, HUD, touch controls, settings, dialogs, guide/confirmations, and system chrome. Semantic tokens, state registry, commands, view models, responsive metrics, platform profiles, topology/path geometry, icon definitions, motion semantics, diagnostics schema, and capture IDs are shared contracts owned by neither renderer alone.",
      "sourceRef": "blueprint/00_EXECUTIVE_DECISIONS.md#architecture-decision"
    },
    {
      "id": "shipping-corridor-not-tiles",
      "category": "rendering",
      "locked": true,
      "statement": "The shipping maze presentation remains connected corridors, not exposed square tiles. Tile topology stays canonical underlying data; visible square-tile boundaries are optional proof/debug treatment only, never the shipping default.",
      "sourceRef": "blueprint/00_EXECUTIVE_DECISIONS.md#rejected-alternatives (Visible tile-square board)"
    },
    {
      "id": "profiles-not-themes",
      "category": "product-boundary",
      "locked": true,
      "statement": "Mobile, desktop, TV, OBS, arcade, and cyberdeck are output profiles, not public themes. Profiles vary layout and density; they never vary brand identity.",
      "sourceRef": "blueprint/00_EXECUTIVE_DECISIONS.md#locked-decisions"
    },
    {
      "id": "single-canonical-theme",
      "category": "product-boundary",
      "locked": true,
      "statement": "One canonical player-facing theme (Fawxzzy Precision Arcade) replaces the public theme matrix. The noir, ember, vellum, aurora, and monolith theme variants are archived historical experiments, not live public options, and no public theme switch ships in the canonical product.",
      "sourceRef": "blueprint/00_EXECUTIVE_DECISIONS.md#product-boundary-decisions"
    },
    {
      "id": "proof-surfaces-internal-only",
      "category": "surface-classification",
      "locked": true,
      "statement": "proof-surfaces.html and visual-proof.html remain internal verification tools (projection QA / critical internal verification), not public product, and are not release-gating core surfaces.",
      "sourceRef": "blueprint/00_EXECUTIVE_DECISIONS.md#product-boundary-decisions"
    },
    {
      "id": "watch-pass-incubating-no-billing",
      "category": "surface-classification",
      "locked": true,
      "statement": "Watch Pass (watch-pass-setup.html, watch-pass-preview.html) remains an incubating companion product behind a feature boundary. watch-pass-paywall.html is a commerce prototype only; no production billing or entitlement claim is permitted until real billing exists.",
      "sourceRef": "blueprint/00_EXECUTIVE_DECISIONS.md#product-boundary-decisions"
    },
    {
      "id": "planet3d-isolated-lab-excluded-from-core-v1",
      "category": "surface-classification",
      "locked": true,
      "statement": "planet3d.html is an isolated lab, explicitly excluded from core-v1 release acceptance.",
      "sourceRef": "blueprint/00_EXECUTIVE_DECISIONS.md#product-boundary-decisions"
    },
    {
      "id": "future-phaser-retire-after-adapter-extraction",
      "category": "surface-classification",
      "locked": true,
      "statement": "future-phaser.html is slated for adapter-lesson extraction (its useful adapter contracts become tests) and then entrypoint retirement.",
      "sourceRef": "blueprint/00_EXECUTIVE_DECISIONS.md#product-boundary-decisions"
    },
    {
      "id": "no-big-bang-menuscene-rewrite",
      "category": "migration-strategy",
      "locked": true,
      "statement": "MenuScene.ts is decomposed through characterization and adapters across later waves, not replaced in one rewrite. A big-bang rewrite is rejected because PR #83 overlaps core ownership and mechanics are already proof-backed.",
      "sourceRef": "blueprint/00_EXECUTIVE_DECISIONS.md#rejected-alternatives (Big-bang rewrite)"
    },
    {
      "id": "pr83-protected-paths-hold",
      "category": "governance",
      "locked": true,
      "statement": "PR #83's listed collision paths (MenuScene.ts, menuRuntimeDiagnostics.ts, legacyAuth.ts, legacyPlayerMessage.ts, shared capture scripts, plus the always-protected vite.config.ts and package.json) are protected and single-owner until PR #83's disposition clears, to be reconciled via a separate later integrator-exclusive PR (Wave 0B), not any parallel lane including this one.",
      "sourceRef": "blueprint/09_MIGRATION_WAVES_AND_PR_LANES.md#file-ownership-guardrails"
    },
    {
      "id": "no-redesign-complete-without-acceptance-matrix",
      "category": "governance",
      "locked": true,
      "statement": "No source lane may claim the redesign complete until the final acceptance matrix (the nine-point Definition of Complete) passes and old duplicated UI paths are removed or formally retained with an owner and purpose.",
      "sourceRef": "blueprint/00_EXECUTIVE_DECISIONS.md#definition-of-complete"
    }
  ],
