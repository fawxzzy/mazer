{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mazer-asset-manifest.v1",
  "title": "Mazer handcrafted asset manifest v1",
  "description": "Structural schema only. File existence, sha256/byte agreement, per-kind format and size limits, magic-byte sniffing, PNG dimension cross-checks, and duplicate id/path detection are enforced by scripts/assets/validate-asset-manifest.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manifestId": { "type": "string", "minLength": 1 },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "format", "bytes", "sha256", "source", "license", "author", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
        "kind": { "enum": ["icon", "image", "material", "animation", "audio", "font"] },
        "path": { "type": "string", "minLength": 1, "description": "POSIX relative path from the manifest directory; no '..', no absolute paths." },
        "format": { "enum": ["svg", "png", "webp", "jpg", "gif", "webm", "ogg", "mp3", "m4a", "woff2", "woff"] },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin", "reference", "createdOn"],
          "properties": {
            "origin": { "enum": ["handcrafted", "ai-assisted", "third-party"] },
            "reference": { "type": "string", "minLength": 1 },
            "createdOn": { "type": "string", "pattern": "^\d{4}-\d{2}-\d{2}$" }
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "holder": { "type": "string", "minLength": 1 }
          }
        },
        "author": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "review", "approved", "deprecated"] }
      }
    }
  }
}
