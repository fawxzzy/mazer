{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "redirects": [
    {
      "source": "/:path((?!sw\\.js$).*)",
      "has": [
        {
          "type": "host",
          "value": "fawxzzy-mazer.vercel.app"
        }
      ],
      "destination": "https://mazer.fawxzzy.com/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/update-password",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    }
  ]
}
