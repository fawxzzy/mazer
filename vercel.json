{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "redirects": [
    {
      "source": "/:path((?!sw\\.js$).*)",
      "has": [
        {
          "type": "host",
          "value": "fawxzzy-mazer.vercel.app"
        }
      ],
      "destination": "https://mazer.fawxzzy.com/:path?compatibility=mazer_legacy_origin",
      "permanent": true
    }
  ]
}
